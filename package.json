{
  "name": "postmaster",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gmail auto-labeler: rules first, cheap Azure AI Foundry model second, config in YAML.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check-config": "tsx src/main.ts --check-config",
    "auth": "tsx scripts/auth.ts",
    "undo": "tsx scripts/undo.ts",
    "eval": "tsx scripts/eval.ts",
    "ci": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage && npm run check-config && npm run build"
  },
  "dependencies": {
    "@googleapis/gmail": "^22.0.2",
    "google-auth-library": "^11.3.2",
    "openai": "^7.45.1",
    "pino": "^9.5.0",
    "yaml": "^2.6.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^5.0.5"
  }
}
