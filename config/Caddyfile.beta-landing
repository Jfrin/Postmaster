# Public synthetic demo and separate beta; OAuth callbacks stay at their registered paths.
{$DEMO_HOST} {
	@beta path / /privacy /terms /beta /beta/* /auth/google/callback /auth/google/gmail/callback
	handle @beta {
		reverse_proxy postmaster-beta:8081
	}
	@demo path /demo /demo/ /api/try
	handle @demo {
		reverse_proxy demo:8080
	}
	handle {
		reverse_proxy auth:4180
	}
}
